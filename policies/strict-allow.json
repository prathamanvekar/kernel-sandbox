{
  "default_deny": true,
  "allow": [
    "read",
    "write",
    "close",
    "openat",
    "fstat",
    "newfstatat",
    "mmap",
    "mprotect",
    "munmap",
    "brk",
    "pread64",
    "access",
    "arch_prctl",
    "set_tid_address",
    "set_robust_list",
    "rseq",
    "prlimit64",
    "execve",
    "exit",
    "exit_group",
    "futex",
    "getrandom",
    "rt_sigaction",
    "rt_sigprocmask",
    "rt_sigreturn"
  ],
  "deny": [],
  "file_access": ["./", "/tmp"],
  "network": false,
  "block_process": true,
  "block_file": false,
  "block_info": false,
  "enforce_file_access": true,
  "landlock": true,
  "drop_caps": true,
  "close_fds": true,
  "rlimit_as_mb": 256,
  "rlimit_nofile": 64,
  "rlimit_nproc": 32,
  "kill_on_violation": false,
  "log_file": "sandbox.log",
  "audit_jsonl": "sandbox.jsonl"
}
